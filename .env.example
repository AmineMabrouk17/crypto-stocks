# Rust backend (apps/web reads BACKEND_ORIGIN from its own .env.local)
HOST=127.0.0.1
PORT=8080
BACKEND_ORIGIN=http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:3000

# Server-side LLM keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Request/retry tuning
REQUEST_TIMEOUT_MS=15000
UPSTREAM_TIMEOUT_MS=8000
RETRY_MAX_ATTEMPTS=3

# Optional upstream overrides (defaults point at production APIs)
# BINANCE_REST_BASE=https://api.binance.com
# COINGECKO_BASE=https://api.coingecko.com/api/v3
# YAHOO_QUERY_BASE=https://query1.finance.yahoo.com
# YAHOO_FC_BASE=https://fc.yahoo.com
# ALTERNATIVE_ME_FNG_BASE=https://api.alternative.me/fng
# POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_BASE=https://clob.polymarket.com
# GOOGLE_NEWS_RSS_BASE=https://news.google.com/rss/search
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GROQ_API_BASE=https://api.groq.com/openai/v1
